{
  "expo": {
    "name": "BatiRent Terrain",
    "slug": "batirent-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d2830"
    },
    "android": {
      "package": "cm.batirent.field",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1d2830"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "BatiRent a besoin de l'appareil photo pour documenter l'état du matériel au retour du chantier."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000"
    }
  }
}
