# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed web origins (Vite dev server + your Vercel domain)
CORS_ORIGINS=http://localhost:5173
# Public base URL of this API (used to build photo URLs when storing locally)
PUBLIC_API_URL=http://localhost:4000

# --- Database (MongoDB Atlas connection string, or local mongod) ---
MONGODB_URI=mongodb://127.0.0.1:27017/batirent

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Overdue engine ---
# Runs every day at this hour (Africa/Douala time)
OVERDUE_CRON=0 6 * * *
CRON_TIMEZONE=Africa/Douala
# Set to false to disable the scheduler (e.g. when running a dedicated worker)
ENABLE_CRON=true

# --- Photo storage ---
# Leave empty to store photos on local disk (/uploads). On Render the disk is ephemeral,
# so set the three Cloudinary values below for production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMS notifications ---
# console  : logs messages to the server console (default, safe for demos)
# webhook  : POSTs {to, message} as JSON to SMS_WEBHOOK_URL (bridge to your SMS gateway)
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
